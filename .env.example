# Copy this file to .env and replace the values with your secure secrets
POSTGRES_DB=hazardmap
POSTGRES_USER=hazardmap
POSTGRES_PASSWORD=CHANGE_ME
CORS_ALLOWED_ORIGINS=https://yourdomain.com
REDIS_URL=redis://redis:6379/0
REDIS_LOCK_FAIL_OPEN=false
ENABLE_DEV_ROUTES=false
WS_MAX_CLIENTS=10000
WS_SEND_TIMEOUT_SECONDS=5.0
CONTOUR_GRID_SIZE=300
VS30_RASTER_PATH=/app/data/soil/india_vs30.tif
# For Kubernetes/object storage, point VS30_RASTER_PATH to a COG via GDAL:
# VS30_RASTER_PATH=/vsicurl/https://example.com/rasters/india_vs30_cog.tif
